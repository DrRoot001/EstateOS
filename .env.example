# Copy to .env and fill in. Anything left blank disables the feature and reports
# itself as unavailable — nothing is ever faked (PRD 7.6).

# ---------------------------------------------------------------- core
DATABASE_URL=
SESSION_SECRET=
APP_URL=http://localhost:8080

# ------------------------------------------------------------------ AI (PRD 61A)
ANTHROPIC_API_KEY=
AI_MODEL_DEFAULT=claude-sonnet-5
AI_MODEL_FAST=claude-haiku-4-5-20251001
AI_EMBEDDING_MODEL=
AI_MONTHLY_BUDGET_USD=
AI_ENABLED=false

# ------------------------------------------- integrations, platform-level app
# registrations only. Customer credentials are stored per organization (PRD 79A).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
DOCUSIGN_INTEGRATION_KEY=
MAPS_API_KEY=

# ------------------------------------------------------------- object storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
